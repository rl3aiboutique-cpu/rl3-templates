{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push origin {{ production_branch }}*)",
      "Bash(git push origin {{ integration_branch }}*)",
      "Bash(git push * {{ production_branch }})",
      "Bash(git push * {{ integration_branch }})",
      "Bash(git push origin HEAD:{{ production_branch }}*)",
      "Bash(git push origin HEAD:{{ integration_branch }}*)",
      "Bash(git push --no-verify*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git checkout {{ production_branch }})",
      "Bash(git checkout main)",
      "Bash(git checkout {{ integration_branch }})",
      "Bash(git switch {{ production_branch }})",
      "Bash(git switch main)",
      "Bash(git switch {{ integration_branch }})",
      "Bash(git reset --hard *)",
      "Bash(git rebase * {{ production_branch }})",
      "Bash(git rebase * {{ integration_branch }})",
      "Bash(git config --global *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(chmod -R *)",
      "Bash(pip install *)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.production)",
      "Edit(.env.staging)",
      "Edit(.env.development)",
      "Edit(.env.test)",
      "Write(.env)",
      "Write(.env.local)",
      "Write(.env.production)",
      "Write(.env.staging)",
      "Write(.env.development)",
      "Write(.env.test)"
    ],
    "allow": [
      "Bash(git push --force-with-lease origin feature/*)",
      "Bash(git push --force-with-lease origin bugfix/*)",
      "Bash(git push --force-with-lease origin chore/*)",
      "Bash(git push --force-with-lease origin release/*)",
      "Bash(git push --force-with-lease origin hotfix/*)",
      "Bash(git checkout -b feature/*)",
      "Bash(git checkout -b bugfix/*)",
      "Bash(git checkout -b chore/*)",
      "Bash(git checkout -b release/*)",
      "Bash(git checkout -b hotfix/*)",
      "Bash(git switch -c feature/*)",
      "Bash(git switch -c bugfix/*)",
      "Bash(git switch -c chore/*)",
      "Bash(git switch -c release/*)",
      "Bash(git switch -c hotfix/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/guard-bash.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/guard-write.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/auto-format.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
