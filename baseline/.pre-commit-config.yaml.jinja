# AUTOGENERATED by rl3-templates baseline. Do not hand-edit between
# `# rl3-templates: managed BEGIN` and `# rl3-templates: managed END`.
# Customise via .copier-answers.yml + `copier update`.
#
# Install:        pre-commit install --install-hooks
# Run all:        pre-commit run --all-files
# Update versions: pre-commit autoupdate

default_language_version:
  python: python3
default_stages: [pre-commit]
fail_fast: false

# rl3-templates: managed BEGIN
exclude: |
  (?x)^(
    node_modules/
    | dist/
    | build/
    | \.venv/
    | \.agents/
    | \.claude/
    | \.cline/
    | \.codi/
    | \.codex/
    | \.cursor/
    | \.windsurf/
    {%- if has_typescript %}
    | {{ frontend_dir }}/src/client/.*
    | {{ frontend_dir }}/src/routeTree\.gen\.ts
    {%- endif %}
    {%- if has_python %}
    | {{ backend_dir }}/app/email-templates/build/.*
    | {{ backend_dir }}/app/alembic/versions/.*\.py$
    {%- endif %}
    | docs/evidence/
  )

repos:
  # ─── Block 1: hygiene ────────────────────────────────────────────────────
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v6.0.0
    hooks:
      - id: trailing-whitespace
      - id: end-of-file-fixer
      - id: mixed-line-ending
        args: ["--fix=lf"]
      - id: check-merge-conflict
      - id: check-case-conflict
      - id: fix-byte-order-marker
      - id: check-yaml
        args: ["--unsafe"]
      - id: check-toml
      - id: check-json
        exclude: 'tsconfig.*\.json$'
      - id: check-added-large-files
        args: ["--maxkb=1000"]
      - id: detect-private-key
      - id: debug-statements
        files: '\.py$'
      - id: no-commit-to-branch
        args:
          - "--branch={{ production_branch }}"
          - "--branch={{ integration_branch }}"
          - "--pattern=^release/"
      - id: check-executables-have-shebangs

  # ─── Block 2: secrets + supply chain ────────────────────────────────────
  - repo: https://github.com/gitleaks/gitleaks
    rev: v8.30.0
    hooks:
      - id: gitleaks
        args: ["--no-banner"]

  - repo: local
    hooks:
      - id: scan-agent-configs
        name: scan agent / MCP config files for secrets (Sandworm-mode mitigation)
        entry: bash scripts/hooks/scan-agent-configs.sh
        language: system
        always_run: true
        pass_filenames: false

      - id: forbid-env-file
        name: forbid committing .env / .env.* (use .env.example)
        entry: ".env / .env.* must not be committed"
        language: fail
        files: '(^|/)\.env(\.[^/]+)?$'
        exclude: '\.env\.example$'

      - id: forbid-credentials
        name: forbid committing private keys, certs, credentials
        entry: "private keys, certificates, and credentials must not be committed"
        language: fail
        files: '\.(pem|key|p12|pfx|jks|keystore)$|/id_rsa$|/credentials\.json$'

{% if enable_anti_slop %}
  # ─── Block 3: anti-slop (AI-specific tier) ──────────────────────────────
  - repo: local
    hooks:
      - id: file-line-cap
        name: file size cap ({{ file_line_cap }} lines)
        entry: python3 scripts/hooks/check_file_lines.py --cap={{ file_line_cap }}
        language: system
        types_or: [python, ts, tsx, javascript, jsx, go, rust]

      - id: orphan-todo
        name: TODO without ticket reference
        entry: |
          bash -c '
            failed=0
            for f in "$@"; do
              if grep -nE "TODO([^(]|$)" "$f" 2>/dev/null \
                 | grep -vE "TODO\([A-Z][A-Z0-9]{1,7}-[0-9]+\)" >/dev/null; then
                echo "$f: orphan TODO — use TODO({{ ticket_prefix }}-N)"
                grep -nE "TODO([^(]|$)" "$f" \
                  | grep -vE "TODO\([A-Z][A-Z0-9]{1,7}-[0-9]+\)" || true
                failed=1
              fi
            done
            exit $failed
          ' --
        language: system
        types: [text]

      - id: not-implemented-stub
        name: forbid NotImplementedError / "not implemented" stubs
        entry: |
          bash -c '
            failed=0
            for f in "$@"; do
              if grep -nE "(raise +NotImplementedError|throw +new +Error\(.not implemented)" "$f" 2>/dev/null; then
                echo "$f: NotImplementedError stub committed"
                failed=1
              fi
            done
            exit $failed
          ' --
        language: system
        types: [text]

      - id: forbid-coauthor-claude
        name: forbid Co-Authored-By Claude in committed content
        entry: |
          bash -c '
            failed=0
            for f in "$@"; do
              if grep -nE "Co-Authored-By: *(Claude|claude|noreply@anthropic)" "$f" 2>/dev/null; then
                echo "$f: forbidden Co-Authored-By Claude trailer"
                failed=1
              fi
            done
            exit $failed
          ' --
        language: system
        types: [text]

      - id: forbid-edits-to-generated
        name: block manual edits to generated files
        entry: "this file is generated — do not hand-edit"
        language: fail
        files: |
          (?x)^(
            {%- if has_typescript %}
            {{ frontend_dir }}/src/routeTree\.gen\.ts$
            | {{ frontend_dir }}/src/client/.*
            |
            {%- endif %}
            .*_pb2\.py$
            | .*\.lock$
            | \.copier-answers\.yml$
          )
{% endif %}

{% if has_python %}
  # ─── Block 4: Python ────────────────────────────────────────────────────
  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v0.15.9
    hooks:
      - id: ruff
        args: ["--fix"]
        files: '^{{ backend_dir }}/'
      - id: ruff-format
        files: '^{{ backend_dir }}/'

  - repo: local
    hooks:
      - id: ruff-restage
        name: re-stage files auto-fixed by ruff
        entry: bash -c 'git diff --name-only --diff-filter=M -- "*.py" | xargs -r git add'
        language: system
        types: [python]
        pass_filenames: false

{% if python_type_checker == "pyright" %}
      - id: pyright
        name: pyright (type check)
        entry: bash -c 'cd {{ backend_dir }} && uv run pyright app/'
        language: system
        files: '^{{ backend_dir }}/.*\.py$'
        pass_filenames: false
{% elif python_type_checker == "ty" %}
      - id: ty
        name: ty (Astral type checker)
        entry: bash -c 'cd {{ backend_dir }} && uv run ty check app/'
        language: system
        files: '^{{ backend_dir }}/.*\.py$'
        pass_filenames: false
{% elif python_type_checker == "mypy-strict" %}
      - id: mypy-strict
        name: mypy --strict
        entry: bash -c 'cd {{ backend_dir }} && uv run mypy app/ --strict'
        language: system
        files: '^{{ backend_dir }}/.*\.py$'
        pass_filenames: false
{% endif %}

{% if python_security_scanner in ["bandit", "both"] %}
      - id: bandit
        name: bandit (deep SAST)
        entry: bash -c 'cd {{ backend_dir }} && uv run bandit -q -c pyproject.toml -r app/'
        language: system
        files: '^{{ backend_dir }}/app/.*\.py$'
        pass_filenames: false
{% endif %}
{% endif %}

{% if has_typescript %}
  # ─── Block 5: TypeScript / frontend ─────────────────────────────────────
  - repo: local
    hooks:
      - id: biome-check
        name: biome check (lint + format)
        entry: |
          bash -c '
            cd {{ frontend_dir }} && pnpm exec biome check \
              --write --no-errors-on-unmatched --files-ignore-unknown=true "$@"
          ' --
        language: system
        files: '^{{ frontend_dir }}/.*\.(ts|tsx|js|jsx|json|jsonc|css)$'
        exclude: '^{{ frontend_dir }}/(dist|src/routeTree\.gen\.ts|src/client)/'
{% endif %}

  # ─── Block 6: infra / docs ──────────────────────────────────────────────
{% if has_docker %}
  - repo: https://github.com/hadolint/hadolint
    rev: v2.13.1-beta
    hooks:
      - id: hadolint-docker
{% endif %}

  - repo: https://github.com/adrienverge/yamllint
    rev: v1.37.1
    hooks:
      - id: yamllint
        args: ["--config-file", ".yamllint.yaml"]
        files: '\.(ya?ml)$'

{% if has_github_actions %}
  - repo: https://github.com/rhysd/actionlint
    rev: v1.7.7
    hooks:
      - id: actionlint
{% endif %}

{% if spellchecker == "typos" %}
  - repo: https://github.com/crate-ci/typos
    rev: v1.30.0
    hooks:
      - id: typos
{% elif spellchecker == "codespell" %}
  - repo: https://github.com/codespell-project/codespell
    rev: v2.4.1
    hooks:
      - id: codespell
        additional_dependencies: ["tomli"]
{% endif %}

  - repo: https://github.com/koalaman/shellcheck-precommit
    rev: v0.10.0
    hooks:
      - id: shellcheck
        args: ["-S", "warning"]

{% if has_terraform %}
  - repo: https://github.com/antonbabenko/pre-commit-terraform
    rev: v1.96.1
    hooks:
      - id: terraform_fmt
      - id: terraform_tflint
{% endif %}

{% if has_ansible %}
  - repo: https://github.com/ansible/ansible-lint
    rev: v25.1.3
    hooks:
      - id: ansible-lint
{% endif %}

  # ─── Block 7: commit-msg + pre-push tier ────────────────────────────────
  - repo: https://github.com/compilerla/conventional-pre-commit
    rev: v4.2.0
    hooks:
      - id: conventional-pre-commit
        stages: [commit-msg]
        args:
          - --strict
          - --types=feat,fix,docs,refactor,test,chore,perf,ci,build,style,revert

  - repo: local
    hooks:
      - id: commit-msg-no-coauthor-claude
        name: reject Co-Authored-By Claude in commit message
        entry: |
          bash -c '
            grep -qE "Co-Authored-By: *(Claude|claude|noreply@anthropic)" "$1" \
              && { echo "ERROR: Co-Authored-By Claude is forbidden"; exit 1; } \
              || exit 0
          ' --
        language: system
        stages: [commit-msg]

      - id: commit-msg-length
        name: first line of commit message must be <= 72 chars
        entry: |
          bash -c '
            head -1 "$1" | awk "length > 72 { print \"ERROR: first line of commit message exceeds 72 chars (\"length\")\"; exit 1 }"
          ' --
        language: system
        stages: [commit-msg]

      # Branch policy (pre-push)
      - id: branch-naming
        name: branch name <prefix>/<git-username>/<slug>
        entry: bash scripts/hooks/check-branch-name.sh
        language: system
        always_run: true
        pass_filenames: false
        stages: [pre-push]

      - id: no-direct-push
        name: refuse direct push to {{ production_branch }} or {{ integration_branch }}
        entry: bash scripts/hooks/no-direct-push.sh
        language: system
        always_run: true
        pass_filenames: false
        stages: [pre-push]

      - id: branch-source-base
        name: feature/* descend from {{ integration_branch }}, hotfix/* from {{ production_branch }}
        entry: bash scripts/hooks/check-branch-base.sh
        language: system
        always_run: true
        pass_filenames: false
        stages: [pre-push]

{% if include_pre_push_tier %}
{% if has_typescript %}
      - id: tsc-noemit
        name: tsc --noEmit
        entry: bash -c 'cd {{ frontend_dir }} && pnpm exec tsc --noEmit'
        language: system
        pass_filenames: false
        files: '^{{ frontend_dir }}/.*\.(ts|tsx)$'
        stages: [pre-push]
{% endif %}
{% if has_python %}
      - id: pip-audit
        name: pip-audit (CVE scan on uv.lock)
        entry: |
          bash -c '
            cd {{ backend_dir }} \
              && uv export --format requirements-txt --no-hashes --no-dev > /tmp/req.txt \
              && uv run pip-audit -r /tmp/req.txt --no-deps
          '
        language: system
        pass_filenames: false
        stages: [pre-push]

      - id: pytest-cov
        name: pytest (cov >= {{ coverage_gate }}%)
        entry: |
          bash -c '
            cd {{ backend_dir }} \
              && uv run pytest tests/ -x -q --cov=app --cov-fail-under={{ coverage_gate }}
          '
        language: system
        pass_filenames: false
        files: '^{{ backend_dir }}/.*\.py$'
        stages: [pre-push]
{% endif %}
{% endif %}
# rl3-templates: managed END
